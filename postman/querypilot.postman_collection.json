{
  "info": { "name": "QueryPilot Text-to-SQL API", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json" },
  "variable": [ { "key": "baseUrl", "value": "http://localhost:8080" }, { "key": "token", "value": "" } ],
  "item": [
    { "name": "Sign up", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"analyst@example.com\",\n  \"password\": \"password123\",\n  \"name\": \"Demo Analyst\"\n}" }, "url": "{{baseUrl}}/api/auth/signup" } },
    { "name": "Schema", "request": { "method": "GET", "url": "{{baseUrl}}/api/schema" } },
    { "name": "Generate SQL", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }], "body": { "mode": "raw", "raw": "{\n  \"question\": \"Show monthly revenue and order count for the last six months\"\n}" }, "url": "{{baseUrl}}/api/query/generate" } },
    { "name": "Execute SQL", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }], "body": { "mode": "raw", "raw": "{\n  \"sql\": \"SELECT status, COUNT(*) AS orders FROM orders GROUP BY status\"\n}" }, "url": "{{baseUrl}}/api/query/execute" } },
    { "name": "History", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/query/history" } },
    { "name": "Favorite query", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }], "body": { "mode": "raw", "raw": "{\n  \"queryId\": 1\n}" }, "url": "{{baseUrl}}/api/query/favorite" } }
  ]
}
